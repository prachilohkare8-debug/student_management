# Server Environment
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your authentic MongoDB Atlas credentials:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/student_management?retryWrites=true&w=majority

# Client Application URL (for CORS allowance)
CLIENT_URL=http://localhost:5173

# Frontend Environment (Vite)
# Point to your deployed backend or local server:
VITE_API_URL=http://localhost:5000/api
